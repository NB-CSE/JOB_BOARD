PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jobboard?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/jobboard

# JWT Security
JWT_SECRET=elevate_careers_jwt_secret_token_2026_super_secure_key
JWT_EXPIRE=30d

# Email Notifications (Nodemailer SMTP)
# Leave empty to use resilient console logger during development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Elevate Careers" <notifications@elevatecareers.io>
